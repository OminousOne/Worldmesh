---
// The landing page's hero: the pitch on one side, a live map of a split world on the other.
// Replaces Starlight's Hero, so it only shows on pages with `hero` in their frontmatter.
import { LinkButton } from '@astrojs/starlight/components';
import WorldMap from './WorldMap.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const captionId = 'wm-map-caption';
---

<div class="wm-hero">
  <div class="copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, link: href, text, variant }) => (
            <LinkButton {href} {variant} class:list={[className]} {...attrs}>
              {text}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>
  <figure class="map">
    <WorldMap {captionId} />
    <figcaption id={captionId}>
      Each color is the area one Spatial Layer Cell owns. You're the cyan dot: every cell your circle
      touches builds part of your view, and your gateway merges them, so you see straight across
      borders. Click the map or use the arrow keys to walk.
    </figcaption>
  </figure>
</div>

<style>
  .wm-hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: 1.5rem 3rem;
  }
  h1 {
    font-family: var(--wm-font-display);
    font-weight: 760;
    font-size: clamp(2.05rem, 1.2rem + 3.2vw, 3.35rem);
    line-height: 1.08;
    letter-spacing: -0.022em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .tagline {
    margin-top: 1.4rem;
    max-width: 32em;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.25rem);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 2rem;
  }
  .map {
    width: 100%;
    max-width: 36rem;
    margin: 0;
  }
  figcaption {
    max-width: 44em;
    margin-top: 1.1rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--sl-color-gray-3);
  }
  @media (min-width: 64rem) {
    .wm-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
      gap: 4rem;
      padding-block: 4rem 4.5rem;
    }
  }
</style>

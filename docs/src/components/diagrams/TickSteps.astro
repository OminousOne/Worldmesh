---
// One tick of a running world, step by step: groups simulate and report to cells, gateways
// say where their players are looking, cells answer and send each gateway its players' views,
// gateways send snapshots, and everything sent waits for the next tick.

type Node = { id: string; label: string; sub: string; x: number; y: number; role: string };
const W = 135;
const H = 58;
const col = [10, 210, 410, 615];
const row = [40, 210];
const nodes: Node[] = [
  { id: 'g1', label: 'Group 1', sub: 'simulates', x: col[0], y: row[0], role: 'group' },
  { id: 'g2', label: 'Group 2', sub: 'simulates', x: col[0], y: row[1], role: 'group' },
  { id: 'ca', label: 'Cell A', sub: 'half the map', x: col[1], y: row[0], role: 'cell' },
  { id: 'cb', label: 'Cell B', sub: 'the other half', x: col[1], y: row[1], role: 'cell' },
  { id: 'w1', label: 'Gateway 1', sub: 'merges views', x: col[2], y: row[0], role: 'gateway' },
  { id: 'w2', label: 'Gateway 2', sub: 'merges views', x: col[2], y: row[1], role: 'gateway' },
  { id: 'p1', label: 'Players', sub: 'on gateway 1', x: col[3], y: row[0], role: 'player' },
  { id: 'p2', label: 'Players', sub: 'on gateway 2', x: col[3], y: row[1], role: 'player' },
];
const at = (id: string) => nodes.find((n) => n.id === id)!;
const right = (n: Node) => [n.x + W, n.y + H / 2] as const;
const left = (n: Node) => [n.x, n.y + H / 2] as const;

// `lane` shifts both ends up or down, so traffic each way gets its own line.
const curve = (a: readonly [number, number], b: readonly [number, number], lane = 0) => {
  const mx = (a[0] + b[0]) / 2;
  return `M${a[0]} ${a[1] + lane}C${mx} ${a[1] + lane} ${mx} ${b[1] + lane} ${b[0]} ${b[1] + lane}`;
};
type Edge = { id: string; role: string; d: string; steps: number[]; back?: boolean };
const edge = (from: string, to: string, step: number, lane: number, back = false): Edge => {
  const a = at(from);
  const b = at(to);
  const forward = a.x < b.x;
  return {
    id: `${from}-${to}`,
    role: a.role,
    d: curve(forward ? right(a) : left(a), forward ? left(b) : right(b), lane),
    steps: [step],
    back,
  };
};
// Each edge is busy in one step.
const edges: Edge[] = [
  // Step 2: reports, and where players are looking.
  ...['g1', 'g2'].flatMap((g) => ['ca', 'cb'].map((c) => edge(g, c, 1, -8))),
  ...['w1', 'w2'].flatMap((w) => ['ca', 'cb'].map((c) => edge(w, c, 1, 9, true))),
  // Step 3: answers back to the groups, and each gateway's own players' views.
  edge('ca', 'g1', 2, 9, true),
  edge('cb', 'g2', 2, 9, true),
  ...['ca', 'cb'].flatMap((c) => ['w1', 'w2'].map((w) => edge(c, w, 2, -8))),
  // Step 4: snapshots.
  edge('w1', 'p1', 3, 0),
  edge('w2', 'p2', 3, 0),
];
const nodeSteps: Record<string, number[]> = {
  g1: [0, 1, 4],
  g2: [0, 1, 4],
  ca: [2],
  cb: [2],
  w1: [1, 3],
  w2: [1, 3],
  p1: [3],
  p2: [3],
};

const steps = [
  {
    role: 'group',
    title: 'The tick starts',
    when: '0 ms',
    body: 'Every group starts tick n at the same moment: they share a clock. Each hands its entities the actions and commands that arrived since the last tick, then runs your systems, stage by stage.',
  },
  {
    role: 'group',
    title: 'Reports go to the cells',
    when: 'a few ms in',
    body: "Each group sends every cell a report of its entities in that cell's area: positions, kinds, visible components, events, and any spatial queries. Each gateway tells every cell where its players are looking.",
  },
  {
    role: 'cell',
    title: 'Cells answer and build views',
    when: 'once every report is in',
    body: "With every group's report in (or after 40 ms), a cell answers the spatial queries, passes area actions on to the groups with entities in range, and builds each player's view of its area. Each gateway gets only its own players' views.",
  },
  {
    role: 'gateway',
    title: 'Gateways send snapshots',
    when: 'once every view is in',
    body: "With every cell's views in (or after 60 ms), each gateway merges its players' parts and sends each of them one snapshot with only what changed.",
  },
  {
    role: 'group',
    title: 'Ready for the next tick',
    when: '100 ms',
    body: 'Actions sent this tick, and its spatial query results, are waiting in the groups. Tick n + 1 delivers them, wherever their targets are.',
  },
];
---

<figure class="wm-figure not-content wm-ticksteps" data-step="0">
  <svg viewBox="0 0 760 300" role="img" aria-label="Two groups, two cells, two gateways and their players, with the messages of one tick">
    <defs>
      <marker id="wm-tick-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10z" />
      </marker>
    </defs>
    {
      edges.map((e) => (
        <path
          id={`wm-tick-${e.id}`}
          class:list={['edge', `role-${e.role}`, { back: e.back }]}
          data-role={e.role}
          d={e.d}
          data-steps={e.steps.join(',')}
          marker-end="url(#wm-tick-arrow)"
        />
      ))
    }
    {
      nodes.map((n) => (
        <g class:list={['node', `role-${n.role}`]} data-steps={nodeSteps[n.id].join(',')} transform={`translate(${n.x} ${n.y})`}>
          <rect width={W} height={H} rx="12" />
          <rect class="band" width="6" height={H - 20} x="10" y="10" rx="3" />
          <text class="label" x={W / 2} y="25">{n.label}</text>
          <text class="sub" x={W / 2} y="44">{n.sub}</text>
        </g>
      ))
    }
    <g class="inbox" data-steps="4">
      <circle cx={col[0] + W} cy={row[0]} r="9" />
      <circle cx={col[0] + W} cy={row[1]} r="9" />
    </g>
  </svg>
  <ol class="wm-steps">
    {
      steps.map((s, i) => (
        <li data-index={i} class={`role-${s.role}`}>
          <span class="chip" aria-hidden="true" />
          <strong>{s.title}</strong> <span class="when">{s.when}</span>
          <p>{s.body}</p>
        </li>
      ))
    }
  </ol>
  <div class="wm-figure-controls" hidden data-controls>
    <button class="wm-btn" type="button" data-go="-1">Back</button>
    <button class="wm-btn primary" type="button" data-go="1">Next step</button>
    <span class="wm-step-count" aria-live="polite">Step 1 of {steps.length}</span>
  </div>
</figure>

<style>
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .role-group {
    --role: var(--wm-role-group);
  }
  .role-cell {
    --role: var(--wm-role-cell);
  }
  .role-gateway {
    --role: var(--wm-role-gateway);
  }
  .role-player {
    --role: var(--wm-role-player);
  }
  .edge.back.role-gateway {
    stroke-dasharray: 3 4;
  }
  .node rect {
    fill: var(--wm-fig-node);
    stroke: color-mix(in oklab, var(--role) 45%, var(--wm-fig-line));
    stroke-width: 1.5;
    transition: stroke 0.2s, fill 0.2s;
  }
  .node .band {
    fill: var(--role);
    stroke: none;
  }
  .node .label {
    font: 700 15px var(--__sl-font);
    fill: var(--wm-fig-text);
    text-anchor: middle;
  }
  .node .sub {
    font: 500 11.5px var(--__sl-font);
    fill: var(--wm-fig-muted);
    text-anchor: middle;
  }
  .node.on rect:not(.band) {
    stroke: var(--role);
    stroke-width: 3;
    fill: color-mix(in oklab, var(--role) 14%, var(--wm-fig-node));
  }
  .edge {
    fill: none;
    stroke: var(--wm-fig-line);
    stroke-width: 1.5;
    opacity: 0.55;
    transition: opacity 0.2s, stroke 0.2s;
  }
  .edge.back {
    stroke-dasharray: 5 5;
  }
  .edge.on {
    stroke: var(--role);
    stroke-width: 2.5;
    opacity: 1;
  }
  marker path {
    fill: var(--wm-fig-muted);
  }
  .inbox {
    opacity: 0;
    transition: opacity 0.2s;
  }
  .inbox.on {
    opacity: 1;
  }
  .inbox circle {
    fill: var(--wm-role-action);
    stroke: var(--wm-fig-node);
    stroke-width: 3;
  }
  :global(.wm-ticksteps .packet) {
    fill: var(--role);
    stroke: var(--wm-fig-node);
    stroke-width: 2;
  }
  :global(.wm-ticksteps .packet.role-group) {
    --role: var(--wm-role-group);
  }
  :global(.wm-ticksteps .packet.role-cell) {
    --role: var(--wm-role-cell);
  }
  :global(.wm-ticksteps .packet.role-gateway) {
    --role: var(--wm-role-gateway);
  }
  .chip {
    display: inline-block;
    width: 0.65rem;
    height: 0.65rem;
    margin-inline-end: 0.45rem;
    border-radius: 50%;
    background: var(--role);
  }
  .wm-steps {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .wm-steps li + li {
    margin-top: 0.9rem;
  }
  .wm-steps strong {
    color: var(--wm-fig-text);
  }
  .wm-steps .when {
    margin-inline-start: 0.35rem;
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }
  .wm-steps p {
    margin: 0.3rem 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  /* Every step sits in the same place, so the figure is as tall as its longest step. */
  .wm-ticksteps.js .wm-steps {
    display: grid;
  }
  .wm-ticksteps.js .wm-steps li {
    grid-area: 1 / 1;
    margin: 0;
  }
  .wm-ticksteps.js .wm-steps li:not(.current) {
    visibility: hidden;
  }
  .wm-step-count {
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  const SVG = 'http://www.w3.org/2000/svg';
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  for (const fig of document.querySelectorAll<HTMLElement>('.wm-ticksteps')) {
    const items = [...fig.querySelectorAll<HTMLElement>('.wm-steps li')];
    const parts = [...fig.querySelectorAll<SVGElement>('[data-steps]')];
    const svg = fig.querySelector('svg')!;
    const count = fig.querySelector<HTMLElement>('.wm-step-count')!;
    const [back, next] = fig.querySelectorAll<HTMLButtonElement>('[data-go]');
    let step = 0;
    fig.classList.add('js');
    fig.querySelector<HTMLElement>('[data-controls]')!.hidden = false;

    function show(i: number) {
      step = (i + items.length) % items.length;
      items.forEach((li, k) => li.classList.toggle('current', k === step));
      for (const p of parts) {
        const on = p.dataset.steps!.split(',').map(Number).includes(step);
        p.classList.toggle('on', on);
      }
      svg.querySelectorAll('.packet').forEach((p) => p.remove());
      if (!still.matches) {
        for (const edge of parts) {
          if (!(edge instanceof SVGPathElement) || !edge.classList.contains('on')) continue;
          const dot = document.createElementNS(SVG, 'circle');
          dot.setAttribute('r', '5');
          dot.setAttribute('class', `packet role-${edge.dataset.role}`);
          const move = document.createElementNS(SVG, 'animateMotion');
          move.setAttribute('dur', '1.3s');
          move.setAttribute('repeatCount', 'indefinite');
          const mpath = document.createElementNS(SVG, 'mpath');
          mpath.setAttribute('href', `#${edge.id}`);
          move.append(mpath);
          dot.append(move);
          svg.append(dot);
        }
      }
      count.textContent = `Step ${step + 1} of ${items.length}`;
      back.disabled = step === 0;
      next.textContent = step === items.length - 1 ? 'Start over' : 'Next step';
    }

    back.addEventListener('click', () => show(step - 1));
    next.addEventListener('click', () => show(step + 1));
    show(0);
  }
</script>

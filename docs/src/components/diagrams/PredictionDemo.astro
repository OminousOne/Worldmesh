---
// Walk around with a delay on the line, with prediction on or off, and watch another player
// drawn from raw snapshots or interpolated between them. Same timing as @worldmesh/client:
// 10 ticks per second, 16 sub-steps, others drawn one tick plus 50 ms in the past.
---

<figure class="wm-figure not-content wm-predict" data-paused="false">
  <div class="stage" tabindex="0" aria-label="Arena. Use the arrow keys or WASD to walk.">
    <svg viewBox="0 0 600 300" aria-hidden="true">
      <defs>
        <pattern id="wm-predict-grid" width="30" height="30" patternUnits="userSpaceOnUse">
          <path class="gridline" d="M30 0H0V30" />
        </pattern>
      </defs>
      <rect class="floor" width="600" height="300" rx="12" />
      <rect class="grid" width="600" height="300" rx="12" fill="url(#wm-predict-grid)" />
      <g class="other">
        <circle data-el="other" cx="300" cy="150" r="11" />
        <text data-el="other-label" x="300" y="128">another player</text>
      </g>
      <g class="ghost">
        <circle data-el="ghost" cx="120" cy="150" r="13" />
        <text data-el="ghost-label" x="120" y="185">server's word</text>
      </g>
      <g class="you">
        <circle data-el="you" cx="120" cy="150" r="11" />
        <text data-el="you-label" x="120" y="128">you</text>
      </g>
    </svg>
    <p class="hint" data-hint>Click here, then walk with the arrow keys or WASD.</p>
  </div>
  <div class="pad" aria-hidden="true">
    <button class="wm-btn" type="button" tabindex="-1" data-dir="0,-1">↑</button>
    <button class="wm-btn" type="button" tabindex="-1" data-dir="-1,0">←</button>
    <button class="wm-btn" type="button" tabindex="-1" data-dir="0,1">↓</button>
    <button class="wm-btn" type="button" tabindex="-1" data-dir="1,0">→</button>
  </div>
  <div class="wm-figure-controls">
    <label class="wm-slider">
      <span>Delay each way</span>
      <input type="range" min="0" max="250" step="10" value="100" data-delay />
      <output data-out="delay">100 ms</output>
    </label>
    <span class="toggles">
      <label class="wm-toggle"><input type="checkbox" checked data-predict /> Predict yourself</label>
      <label class="wm-toggle"><input type="checkbox" checked data-smooth /> Interpolate others</label>
      <label class="wm-toggle"><input type="checkbox" data-jitter /> Jitter</label>
    </span>
    <button class="wm-btn pause" type="button" data-pause>Pause</button>
  </div>
  <p class="wm-figure-readout" data-readout></p>
</figure>

<style>
  .stage {
    position: relative;
    border-radius: 12px;
    outline: none;
  }
  .stage:focus-visible {
    outline: 3px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .floor {
    fill: var(--wm-fig-node);
  }
  .gridline {
    fill: none;
    stroke: var(--wm-fig-grid);
    stroke-width: 1;
  }
  text {
    font: 600 12px var(--__sl-font);
    text-anchor: middle;
    fill: var(--wm-fig-muted);
  }
  .you circle {
    fill: var(--wm-fig-active);
    stroke: #00435a;
    stroke-width: 3;
  }
  .you text {
    fill: var(--wm-fig-text);
  }
  .ghost circle {
    fill: none;
    stroke: var(--wm-role-group);
    stroke-width: 2.5;
    stroke-dasharray: 4 3;
  }
  .ghost text {
    fill: var(--wm-role-group);
  }
  .other circle {
    fill: var(--wm-role-player);
    stroke: #00435a;
    stroke-width: 3;
  }
  .toggles {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
  }
  .pause {
    margin-inline-start: auto;
  }
  .hint {
    position: absolute;
    inset: auto 0 0.75rem;
    margin: 0;
    text-align: center;
    font-size: 0.85rem;
    color: var(--wm-fig-muted);
    pointer-events: none;
  }
  .stage:focus .hint {
    visibility: hidden;
  }
  .pad {
    display: none;
    grid-template-columns: repeat(4, 3rem);
    gap: 0.5rem;
    justify-content: center;
    margin-top: 0.75rem;
  }
  .pad .wm-btn {
    height: 3rem;
    font-size: 1.1rem;
    touch-action: none;
  }
  @media (pointer: coarse) {
    .pad {
      display: grid;
    }
  }
</style>

<script>
  const TICK = 100;
  const SUBS = 16;
  const SUB = TICK / SUBS;
  const SPEED = 4 / 1000; // tiles per ms
  const UNIT = 30; // svg units per tile
  const W = 20;
  const H = 10;
  const INTERP = TICK + 50;
  const MARGIN = 15; // the lead leaves inputs 15 ms early

  type Dir = { dx: number; dy: number };
  type Sample = { t: number; x: number; y: number };

  for (const fig of document.querySelectorAll<HTMLElement>('.wm-predict')) run(fig);

  function run(fig: HTMLElement) {
    const el = (name: string) => fig.querySelector<SVGElement>(`[data-el="${name}"]`)!;
    const stage = fig.querySelector<HTMLElement>('.stage')!;
    const readout = fig.querySelector<HTMLElement>('[data-readout]')!;
    const delayInput = fig.querySelector<HTMLInputElement>('[data-delay]')!;
    const predictInput = fig.querySelector<HTMLInputElement>('[data-predict]')!;
    const smoothInput = fig.querySelector<HTMLInputElement>('[data-smooth]')!;
    const jitterInput = fig.querySelector<HTMLInputElement>('[data-jitter]')!;
    const pauseButton = fig.querySelector<HTMLButtonElement>('[data-pause]')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)');

    // The demo's own clock, so pausing freezes everything.
    let clock = 0;
    let last = 0;
    let paused = still.matches;
    let onScreen = false;
    let frame = 0;

    // Your entity on the server: inputs by the sub-step they take effect at, and positions
    // at the start of every sub-step, worked out as far as anyone needs.
    const inputs: { sub: number; dir: Dir }[] = [{ sub: 0, dir: { dx: 0, dy: 0 } }];
    const start = { x: 4, y: 5 };
    const positions: { x: number; y: number }[] = [start];
    const dirAt = (sub: number) => {
      for (let i = inputs.length - 1; i >= 0; i--) if (inputs[i].sub <= sub) return inputs[i].dir;
      return inputs[0].dir;
    };
    const clampX = (x: number) => Math.min(W - 0.5, Math.max(0.5, x));
    const clampY = (y: number) => Math.min(H - 0.5, Math.max(0.5, y));
    function serverAt(t: number) {
      const k = Math.max(0, Math.floor(t / SUB));
      while (positions.length <= k) {
        const i = positions.length - 1;
        const p = positions[i];
        const d = dirAt(i);
        positions.push({ x: clampX(p.x + d.dx * SPEED * SUB), y: clampY(p.y + d.dy * SPEED * SUB) });
      }
      const p = positions[k];
      const d = dirAt(k);
      const into = t - k * SUB;
      return { x: clampX(p.x + d.dx * SPEED * into), y: clampY(p.y + d.dy * SPEED * into) };
    }
    function schedule(sub: number, dir: Dir) {
      const later = inputs[inputs.length - 1].sub;
      sub = Math.max(sub, later);
      if (later === sub) inputs[inputs.length - 1] = { sub, dir };
      else inputs.push({ sub, dir });
      if (positions.length > sub + 1) positions.length = sub + 1;
    }

    // Another player walking a figure eight.
    const otherAt = (t: number) => ({
      x: 10 + 6.5 * Math.cos((t / 9000) * Math.PI * 2),
      y: 5 + 3 * Math.sin((t / 4500) * Math.PI * 2),
    });

    // Snapshots: one per tick, arriving after the delay (and jitter, never out of order).
    const mine: Sample[] = [];
    const theirs: Sample[] = [];
    const inFlight: { due: number; t: number }[] = [];
    let lastTick = -1;
    let lastDue = 0;
    const delay = () => Number(delayInput.value);

    function network() {
      const tick = Math.floor(clock / TICK);
      for (let n = lastTick + 1; n <= tick; n++) {
        const jitter = jitterInput.checked ? Math.random() * 60 : 0;
        lastDue = Math.max(lastDue, n * TICK + delay() + jitter);
        inFlight.push({ due: lastDue, t: n * TICK });
      }
      lastTick = tick;
      while (inFlight.length && inFlight[0].due <= clock) {
        const { t } = inFlight.shift()!;
        mine.push({ t, ...serverAt(t) });
        theirs.push({ t, ...otherAt(t) });
      }
      for (const list of [mine, theirs]) while (list.length > 40) list.shift();
    }

    function sampleAt(samples: Sample[], t: number) {
      if (!samples.length) return null;
      if (t <= samples[0].t) return samples[0];
      for (let i = samples.length - 1; i >= 0; i--) {
        if (samples[i].t <= t) {
          const a = samples[i];
          const b = samples[i + 1];
          if (!b) return a;
          const k = (t - a.t) / (b.t - a.t);
          return { t, x: a.x + (b.x - a.x) * k, y: a.y + (b.y - a.y) * k };
        }
      }
      return samples[samples.length - 1];
    }

    // Keys held right now, and what they add up to.
    const held = new Map<string, Dir>();
    let current: Dir = { dx: 0, dy: 0 };
    function changed() {
      let dx = 0;
      let dy = 0;
      for (const d of held.values()) {
        dx += d.dx;
        dy += d.dy;
      }
      const len = Math.hypot(dx, dy);
      const next = len ? { dx: dx / len, dy: dy / len } : { dx: 0, dy: 0 };
      if (next.dx === current.dx && next.dy === current.dy) return;
      current = next;
      // Predicted: scheduled a lead ahead, so it reaches the server just in time and shows now.
      // Not predicted: sent for "as soon as possible", which is the first tick after it arrives.
      const at = predictInput.checked
        ? clock + delay() + MARGIN
        : Math.ceil((clock + delay()) / TICK) * TICK;
      schedule(Math.ceil(at / SUB), current);
      if (paused) setPaused(false);
      wake();
    }

    const svgX = (x: number) => x * UNIT;
    const svgY = (y: number) => y * UNIT;
    function place(name: string, p: { x: number; y: number }, label: string, dy: number) {
      el(name).setAttribute('cx', svgX(p.x).toFixed(1));
      el(name).setAttribute('cy', svgY(p.y).toFixed(1));
      el(label).setAttribute('x', svgX(p.x).toFixed(1));
      el(label).setAttribute('y', (svgY(p.y) + dy).toFixed(1));
    }

    function draw() {
      const shownAt = clock - delay() - INTERP;
      const you = predictInput.checked
        ? serverAt(clock + delay() + MARGIN)
        : sampleAt(mine, shownAt) ?? start;
      const word = mine.length ? mine[mine.length - 1] : start;
      const other = smoothInput.checked ? sampleAt(theirs, shownAt) : theirs[theirs.length - 1];
      place('you', you, 'you-label', -20);
      place('ghost', word, 'ghost-label', 30);
      if (other) place('other', other, 'other-label', -20);
    }

    function describe() {
      const d = delay();
      const words = predictInput.checked
        ? `Your moves show at once. The server's word on you (the orange ring) follows about ${2 * d + MARGIN} ms behind, plus up to a tick.`
        : `Your moves show about ${2 * d + TICK / 2 + INTERP} ms after you press: ${d} ms to the server, up to a tick's wait, ${d} ms back, and the ${INTERP} ms everyone else is drawn behind.`;
      const others = smoothInput.checked
        ? `The other player is drawn ${INTERP} ms behind the newest snapshot, blended between two, so it moves smoothly${jitterInput.checked ? ' even with jitter' : ''}.`
        : `The other player jumps to each snapshot as it arrives, ten times a second${jitterInput.checked ? ', unevenly with jitter' : ''}.`;
      readout.textContent = `${words} ${others}`;
    }

    function tick(now: number) {
      frame = 0;
      if (last) clock += Math.min(50, now - last);
      last = now;
      network();
      draw();
      if (onScreen && !paused && !document.hidden) frame = requestAnimationFrame(tick);
    }
    // Starts the loop if it's stopped. The loop keeps itself going until paused or off screen.
    function wake() {
      if (!frame && onScreen && !paused && !document.hidden) {
        last = 0;
        frame = requestAnimationFrame(tick);
      }
    }
    function setPaused(p: boolean) {
      paused = p;
      pauseButton.textContent = p ? 'Play' : 'Pause';
      fig.dataset.paused = String(p);
      if (!p) wake();
    }

    const KEYS: Record<string, Dir> = {
      ArrowUp: { dx: 0, dy: -1 },
      ArrowDown: { dx: 0, dy: 1 },
      ArrowLeft: { dx: -1, dy: 0 },
      ArrowRight: { dx: 1, dy: 0 },
      w: { dx: 0, dy: -1 },
      s: { dx: 0, dy: 1 },
      a: { dx: -1, dy: 0 },
      d: { dx: 1, dy: 0 },
    };
    const keyOf = (e: KeyboardEvent) => (e.key.length === 1 ? e.key.toLowerCase() : e.key);
    stage.addEventListener('keydown', (e) => {
      const k = keyOf(e);
      if (!KEYS[k]) return;
      e.preventDefault();
      if (e.repeat) return;
      held.set(k, KEYS[k]);
      changed();
    });
    stage.addEventListener('keyup', (e) => {
      if (held.delete(keyOf(e))) changed();
    });
    stage.addEventListener('blur', () => {
      held.clear();
      changed();
    });
    stage.addEventListener('pointerdown', () => stage.focus());
    for (const b of fig.querySelectorAll<HTMLButtonElement>('[data-dir]')) {
      const [dx, dy] = b.dataset.dir!.split(',').map(Number);
      const key = `pad${b.dataset.dir}`;
      b.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        held.set(key, { dx, dy });
        changed();
      });
      for (const end of ['pointerup', 'pointerleave', 'pointercancel']) {
        b.addEventListener(end, () => {
          if (held.delete(key)) changed();
        });
      }
    }

    delayInput.addEventListener('input', () => {
      fig.querySelector('[data-out="delay"]')!.textContent = `${delayInput.value} ms`;
      describe();
    });
    for (const i of [predictInput, smoothInput, jitterInput]) i.addEventListener('change', describe);
    pauseButton.addEventListener('click', () => setPaused(!paused));
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      wake();
    }).observe(fig);
    document.addEventListener('visibilitychange', wake);

    setPaused(paused);
    describe();
    draw();
  }
</script>

---
// A live map for the landing page: four cells' areas, players wandering across them, and your
// view lighting up every area it touches. Rendered on the server; the script below animates it.
import { H, REGIONS, VIEW, W, junction, regionAt, seamX, seamY, seeded, touched } from './world-map';

interface Props {
  captionId: string;
}
const { captionId } = Astro.props;

type Pt = [number, number];
const step = 6;
const j = junction();
const path = (pts: Pt[], close = true) =>
  'M' + pts.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join('L') + (close ? 'Z' : '');

const vNorth: Pt[] = [];
for (let y = 0; y < j.y; y += step) vNorth.push([seamX(y), y]);
vNorth.push([j.x, j.y]);
const vSouth: Pt[] = [[j.x, j.y]];
for (let y = Math.ceil(j.y / step) * step; y < H; y += step) vSouth.push([seamX(y), y]);
vSouth.push([seamX(H), H]);
const hWest: Pt[] = [];
for (let x = 0; x < j.x; x += step) hWest.push([x, seamY(x)]);
hWest.push([j.x, j.y]);
const hEast: Pt[] = [[j.x, j.y]];
for (let x = Math.ceil(j.x / step) * step; x < W; x += step) hEast.push([x, seamY(x)]);
hEast.push([W, seamY(W)]);

const rev = (pts: Pt[]) => [...pts].reverse();
const areas = {
  forest: path([[0, 0], ...vNorth, ...rev(hWest)]),
  volcano: path([[W, 0], [W, seamY(W)], ...rev(hEast), ...rev(vNorth)]),
  ocean: path([[0, H], [0, seamY(0)], ...hWest, ...vSouth]),
  sand: path([[W, H], ...rev(vSouth), ...hEast]),
};
const seams = [path([...vNorth, ...vSouth.slice(1)], false), path([...hWest, ...hEast.slice(1)], false)];

// Players, placed the same way on every build.
const rand = seeded(7);
const players = Array.from({ length: 24 }, () => ({
  x: 22 + rand() * (W - 44),
  y: 22 + rand() * (H - 44),
}));
const you = { x: 178, y: 150 };
const seen = touched(you.x, you.y);
const inView = (p: { x: number; y: number }) => Math.hypot(p.x - you.x, p.y - you.y) <= VIEW;

const trees: Pt[] = [[62, 62], [128, 44], [104, 118], [192, 78], [52, 150], [236, 34]];
const waves: Pt[] = [[70, 292], [176, 340], [54, 372], [150, 262], [230, 396]];
const dunes: Pt[] = [[372, 318], [448, 366], [330, 384], [470, 282], [402, 260]];
for (const [x, y] of trees) if (regionAt(x, y) !== 'forest') throw new Error(`tree at ${x},${y}`);
for (const [x, y] of waves) if (regionAt(x, y) !== 'ocean') throw new Error(`wave at ${x},${y}`);
for (const [x, y] of dunes) if (regionAt(x, y) !== 'sand') throw new Error(`dune at ${x},${y}`);
---

<div
  class="wm-map"
  tabindex="0"
  aria-label="Live map of a world split into four cells' areas. Use the arrow keys to walk."
  aria-describedby={captionId}
>
  <svg viewBox={`-4 -4 ${W + 8} ${H + 22}`} aria-hidden="true">
    <defs>
      <clipPath id="wm-land"><rect width={W} height={H} rx="44" /></clipPath>
    </defs>
    <rect class="slab" y="14" width={W} height={H} rx="44" />
    <g clip-path="url(#wm-land)">
      {REGIONS.map((r) => (
        <g class:list={['region', r, { 'is-seen': seen.has(r) }]} data-region={r}>
          <path class="ground" d={areas[r]} />
          {r === 'forest' &&
            trees.map(([x, y]) => (
              <g class="tree" transform={`translate(${x} ${y})`}>
                <path class="trunk" d="M-3 4 L3 4 L4 16 L-4 16 Z" />
                <circle cx="-6" cy="2" r="10" />
                <circle cx="6" cy="0" r="11" />
                <circle cx="0" cy="-8" r="10" />
              </g>
            ))}
          {r === 'volcano' && (
            <g class="cone" transform="translate(408 112)">
              <path d="M-74 64 C-50 30 -34 -18 -20 -44 L20 -44 C34 -18 52 30 78 64 Z" />
              <ellipse class="crater" cx="0" cy="-44" rx="20" ry="7" />
              <path class="lava" d="M2 -40 C6 -20 -2 0 16 22 C24 32 30 44 36 60" />
            </g>
          )}
          {r === 'ocean' &&
            waves.map(([x, y]) => <path class="wave" d={`M${x - 22} ${y} q11 -12 22 0 t22 0`} />)}
          {r === 'sand' &&
            dunes.map(([x, y]) => <path class="dune" d={`M${x - 30} ${y + 6} q30 -22 60 0`} />)}
          <path class="fog" d={areas[r]} />
        </g>
      ))}
      {seams.map((d) => <path class="seam-edge" d={d} />)}
      {seams.map((d) => <path class="seam" d={d} />)}
      <g transform={`translate(${j.x.toFixed(1)} ${j.y.toFixed(1)}) rotate(45)`}>
        <rect class="hub" x="-17" y="-17" width="34" height="34" rx="4" />
        <rect class="hub-core" x="-8" y="-8" width="16" height="16" rx="2" />
      </g>
      <circle class="view" cx={you.x} cy={you.y} r={VIEW} />
      {players.map((p) => (
        <circle class:list={['player', { 'in-view': inView(p) }]} cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="5.5" />
      ))}
      <circle class="you" cx={you.x} cy={you.y} r="8.5" />
    </g>
    <rect class="rim" width={W} height={H} rx="44" />
  </svg>
</div>

<style>
  .wm-map {
    border-radius: 2.75rem;
    cursor: crosshair;
    touch-action: manipulation;
  }
  .wm-map:focus-visible {
    outline: 3px solid var(--sl-color-text-accent);
    outline-offset: 6px;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .slab {
    fill: #00435a;
  }
  .rim {
    fill: none;
    stroke: #00435a;
    stroke-width: 5;
  }
  /* Areas whose cell adds nothing to your view stay under fog. */
  .fog {
    fill: #eaf6f9;
    opacity: 0.6;
    transition: opacity 0.4s ease;
  }
  .is-seen .fog {
    opacity: 0;
  }
  .forest .ground {
    fill: #a4e000;
  }
  .tree circle {
    fill: #5f9e00;
  }
  .tree circle:last-child {
    fill: #7cbd00;
  }
  .trunk {
    fill: #b3561c;
  }
  .volcano .ground {
    fill: #f55262;
  }
  .cone > path:first-child {
    fill: #d73a4c;
  }
  .crater {
    fill: #a8203a;
  }
  .lava {
    fill: none;
    stroke: #fb9a00;
    stroke-width: 5;
    stroke-linecap: round;
  }
  .ocean .ground {
    fill: #05a3d1;
  }
  .wave {
    fill: none;
    stroke: #5eeeff;
    stroke-width: 4;
    stroke-linecap: round;
  }
  .sand .ground {
    fill: #fbbe05;
  }
  .dune {
    fill: none;
    stroke: #f28a03;
    stroke-width: 4;
    stroke-linecap: round;
  }
  .seam-edge {
    fill: none;
    stroke: #00435a;
    stroke-width: 17;
    stroke-linejoin: round;
  }
  .seam {
    fill: none;
    stroke: #0bf4fd;
    stroke-width: 9;
    stroke-linejoin: round;
  }
  .hub {
    fill: #0bf4fd;
    stroke: #00435a;
    stroke-width: 4;
  }
  .hub-core {
    fill: none;
    stroke: #00435a;
    stroke-width: 3.5;
  }
  .view {
    fill: rgb(255 255 255 / 0.16);
    stroke: #ffffff;
    stroke-width: 2.5;
    stroke-dasharray: 7 6;
  }
  .player {
    fill: #ffffff;
    stroke: #0b2430;
    stroke-width: 2;
    opacity: 0.4;
    transition: opacity 0.25s;
  }
  .player.in-view {
    opacity: 1;
  }
  .you {
    fill: #0bf4fd;
    stroke: #00435a;
    stroke-width: 3.5;
  }
  @media (prefers-reduced-motion: reduce) {
    .fog,
    .player {
      transition: none;
    }
  }
</style>

<script>
  import { H, REGIONS, VIEW, W, touched } from './world-map';

  const KEYS: Record<string, [number, number]> = {
    ArrowUp: [0, -1],
    ArrowDown: [0, 1],
    ArrowLeft: [-1, 0],
    ArrowRight: [1, 0],
    w: [0, -1],
    s: [0, 1],
    a: [-1, 0],
    d: [1, 0],
  };
  const EDGE = 14;
  const clampX = (x: number) => Math.min(W - EDGE, Math.max(EDGE, x));
  const clampY = (y: number) => Math.min(H - EDGE, Math.max(EDGE, y));

  for (const root of document.querySelectorAll<HTMLElement>('.wm-map')) run(root);

  function run(root: HTMLElement) {
    const svg = root.querySelector('svg')!;
    const youEl = root.querySelector<SVGCircleElement>('.you')!;
    const viewEl = root.querySelector<SVGCircleElement>('.view')!;
    const regionEls = new Map(REGIONS.map((r) => [r, root.querySelector(`[data-region="${r}"]`)!]));
    const players = [...root.querySelectorAll<SVGCircleElement>('.player')].map((el) => ({
      el,
      x: Number(el.getAttribute('cx')),
      y: Number(el.getAttribute('cy')),
      heading: Math.random() * Math.PI * 2,
      speed: 12 + Math.random() * 16,
    }));
    const you = { x: Number(youEl.getAttribute('cx')), y: Number(youEl.getAttribute('cy')) };
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const held = new Set<string>();
    let target: { x: number; y: number } | null = null;
    // Until someone takes over, you wander from place to place on your own.
    let autopilot = !still.matches;
    let onScreen = true;
    let frame = 0;
    let last = 0;

    const wander = () => {
      target = { x: 50 + Math.random() * (W - 100), y: 50 + Math.random() * (H - 100) };
    };
    const busy = () => !still.matches || held.size > 0 || target !== null;
    // Starts the loop if it's stopped. The loop keeps itself going while there's anything to move.
    const wake = () => {
      if (!frame && onScreen && !document.hidden && busy()) {
        last = 0;
        frame = requestAnimationFrame(tick);
      }
    };

    function tick(now: number) {
      frame = 0;
      const dt = last ? Math.min(0.05, (now - last) / 1000) : 0;
      last = now;

      let dx = 0;
      let dy = 0;
      for (const key of held) {
        dx += KEYS[key][0];
        dy += KEYS[key][1];
      }
      if (dx || dy) {
        const len = Math.hypot(dx, dy);
        you.x = clampX(you.x + (dx / len) * 110 * dt);
        you.y = clampY(you.y + (dy / len) * 110 * dt);
      } else if (target) {
        const speed = autopilot ? 34 : 130;
        const left = Math.hypot(target.x - you.x, target.y - you.y);
        if (left <= speed * dt) {
          you.x = target.x;
          you.y = target.y;
          target = null;
          if (autopilot) setTimeout(() => (wander(), wake()), 900);
        } else {
          you.x += ((target.x - you.x) / left) * speed * dt;
          you.y += ((target.y - you.y) / left) * speed * dt;
        }
      }

      if (!still.matches) {
        for (const p of players) {
          p.heading += (Math.random() - 0.5) * 2.4 * dt;
          let x = p.x + Math.cos(p.heading) * p.speed * dt;
          let y = p.y + Math.sin(p.heading) * p.speed * dt;
          if (x < EDGE || x > W - EDGE) p.heading = Math.PI - p.heading;
          if (y < EDGE || y > H - EDGE) p.heading = -p.heading;
          p.x = clampX(x);
          p.y = clampY(y);
        }
      }
      draw();
      if (onScreen && !document.hidden && busy()) frame = requestAnimationFrame(tick);
    }

    function draw() {
      youEl.setAttribute('cx', you.x.toFixed(1));
      youEl.setAttribute('cy', you.y.toFixed(1));
      viewEl.setAttribute('cx', you.x.toFixed(1));
      viewEl.setAttribute('cy', you.y.toFixed(1));
      for (const p of players) {
        p.el.setAttribute('cx', p.x.toFixed(1));
        p.el.setAttribute('cy', p.y.toFixed(1));
        p.el.classList.toggle('in-view', Math.hypot(p.x - you.x, p.y - you.y) <= VIEW);
      }
      const seen = touched(you.x, you.y);
      for (const [r, el] of regionEls) el.classList.toggle('is-seen', seen.has(r));
    }

    const takeOver = () => {
      autopilot = false;
    };

    svg.addEventListener('pointerdown', (e) => {
      const m = svg.getScreenCTM();
      if (!m) return;
      const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
      takeOver();
      target = { x: clampX(p.x), y: clampY(p.y) };
      wake();
    });
    root.addEventListener('keydown', (e) => {
      const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
      if (!(key in KEYS)) return;
      e.preventDefault();
      takeOver();
      target = null;
      held.add(key);
      wake();
    });
    root.addEventListener('keyup', (e) => {
      held.delete(e.key.length === 1 ? e.key.toLowerCase() : e.key);
    });
    root.addEventListener('blur', () => held.clear());

    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      wake();
    }).observe(root);
    document.addEventListener('visibilitychange', wake);
    still.addEventListener('change', () => {
      if (still.matches) autopilot = false;
      wake();
    });

    if (autopilot) wander();
    wake();
  }
</script>
